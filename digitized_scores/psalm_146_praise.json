  "verses": [
    {
      "verse_number": 1,
      "lyrics_text": "It is the Lord who keeps faith forever, who is just to those who are oppressed. It is he who gives bread to the hungry, the Lord who sets prisoners free.",
      "chords": [
        "Fm7",
        "Bbm7",
