        }
      ]
    },
    {
      "verse_number": 2,
      "lyrics_text": "It is the Lord who gives sight to the blind, who raises up those who are bowed down. It is the Lord who loves the just, the Lord who protects the stranger.",
      "chords": [
        "Fm7",
        "Bbm7",
        "Ebm7",
        "Ab"
      ],
      "notes": [
        {
          "pitch": "Db4",
          "midi": 61,
          "duration": "quarter",
          "beats": 1.0,
