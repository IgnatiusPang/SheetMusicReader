        }
      ]
    },
    {
      "verse_number": 2,
      "lyrics_text": "The Lord turns his face against the wicked to destroy their remembrance from the earth. The just call and the Lord hears and rescues them in all their distress.",
      "chords": [
        "Bm",
        "F#m",
        "G",
        "A"
      ],
      "notes": [
        {
          "pitch": "F#4",
          "midi": 66,
